rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.email == 'solarjameson@gmail.com'; }
    function team() { return owner() || (signedIn() && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))); }
    match /routeStops/{stopId} { allow read, write: if team(); }
    match /allowedEmails/{email} { allow read: if team(); allow create, update, delete: if owner(); }
  }
}
